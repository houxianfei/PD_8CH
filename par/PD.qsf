# Eight-channel AD7380 / FT232H. Reference: afs_v1 ae1a285.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY PD
set_global_assignment -name LAST_QUARTUS_VERSION "22.1std.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE PD.sdc
set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:../scripts/check_pins.tcl"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name ENABLE_NCE_PIN OFF
set_global_assignment -name ENABLE_BOOT_SEL_PIN OFF
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name VERILOG_FILE ../rtl/PD.v
set_global_assignment -name VERILOG_FILE ../rtl/PD_core.v
set_global_assignment -name VERILOG_FILE ../rtl/axis_fifo.v
set_global_assignment -name VERILOG_FILE ../rtl/axis_frame_arbiter.v
set_global_assignment -name VERILOG_FILE ../rtl/control_register.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/axi_stream_assert.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/axi_stream_downsizing.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/axi_stream_packing.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/axi_stream_resizing.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/axi_stream_upsizing.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/fifo2.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/fifo4.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/fifo_async.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/fifo_delay_submit.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/ftdi_245fifo_fsm.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/ftdi_245fifo_top.v
set_global_assignment -name VERILOG_FILE ../rtl/ftdi_245/resetn_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/packet.v
set_global_assignment -name VERILOG_FILE ../rtl/Sensor_Collection.v
set_global_assignment -name VERILOG_FILE ../rtl/spi_master.v
set_global_assignment -name VERILOG_FILE ../rtl/USB_axi4lite.v
set_global_assignment -name VERILOG_FILE ../rtl/usb_command_assembler.v
set_location_assignment PIN_25 -to usb_clk_60m
set_location_assignment PIN_23 -to clk50M
set_location_assignment PIN_70 -to Rst_n
set_location_assignment PIN_125 -to usb_oe_n
set_location_assignment PIN_129 -to usb_rd_n
set_location_assignment PIN_120 -to usb_rxf_n
set_location_assignment PIN_127 -to usb_siwu_n
set_location_assignment PIN_128 -to usb_wr_n
set_location_assignment PIN_132 -to usb_txe_n
set_location_assignment PIN_101 -to spiclk
set_location_assignment PIN_99 -to spics
set_location_assignment PIN_104 -to spido
set_location_assignment PIN_76 -to spidiT[3]
set_location_assignment PIN_75 -to spidiT[2]
set_location_assignment PIN_73 -to spidiT[1]
set_location_assignment PIN_71 -to spidiT[0]
set_location_assignment PIN_100 -to spidiB[3]
set_location_assignment PIN_103 -to spidiB[2]
set_location_assignment PIN_105 -to spidiB[1]
set_location_assignment PIN_106 -to spidiB[0]
set_location_assignment PIN_144 -to usb_data[0]
set_location_assignment PIN_143 -to usb_data[1]
set_location_assignment PIN_142 -to usb_data[2]
set_location_assignment PIN_141 -to usb_data[3]
set_location_assignment PIN_138 -to usb_data[4]
set_location_assignment PIN_137 -to usb_data[5]
set_location_assignment PIN_136 -to usb_data[6]
set_location_assignment PIN_135 -to usb_data[7]
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
# All 28 top-level signals have explicit board pin assignments.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
